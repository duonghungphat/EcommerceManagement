@model EcommerceManagement.Core.ViewModels.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Hệ thống quản lý bán hàng</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/zuramai/mazer@@docs/demo/assets/compiled/css/app.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/zuramai/mazer@@docs/demo/assets/compiled/css/app-dark.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <script>
        if (!localStorage.getItem("theme")) {
            localStorage.setItem("theme", "dark");
        }
    </script>
</head>

<body class="mazer-login-page">
    <script src="https://cdn.jsdelivr.net/gh/zuramai/mazer@@docs/demo/assets/static/js/initTheme.js"></script>

    <div class="mazer-login-theme">
        <div class="theme-toggle d-flex gap-2 align-items-center">
            <span>☀</span>
            <div class="form-check form-switch fs-6 mb-0">
                <input class="form-check-input me-0" type="checkbox" id="toggle-dark" style="cursor:pointer" />
            </div>
            <span>☾</span>
        </div>
    </div>

    <div class="min-vh-100 d-flex align-items-center justify-content-center py-4">
        <div class="mazer-login-shell">
            <div class="row g-0">
                <div class="col-lg-7">
                    <section class="mazer-login-side h-100 d-flex flex-column justify-content-between">
                        <div>
                            <span class="mazer-brand-mark">BH</span>
                            <h1>Quản lý bán hàng rõ ràng hơn mỗi ngày.</h1>
                            <p>
                                Theo dõi sản phẩm, khách hàng, đơn hàng, thanh toán và hoạt động hệ thống trong cùng một nơi.
                            </p>
                        </div>

                        <div class="small text-white-50">
                            Hệ thống quản trị nội bộ
                        </div>
                    </section>
                </div>

                <div class="col-lg-5">
                    <section class="mazer-login-panel">
                        <div class="mb-4">
                            <div class="text-primary fw-bold mb-2">HỆ THỐNG QUẢN LÝ BÁN HÀNG</div>
                            <h2>Đăng nhập</h2>
                            <p class="text-muted mb-0">Sử dụng tài khoản được cấp để truy cập hệ thống.</p>
                        </div>

                        <form asp-controller="Account" asp-action="Login" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email" class="form-control form-control-lg" placeholder="Nhập email" autocomplete="email" autofocus />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">Mật khẩu</label>
                                <input asp-for="Password" class="form-control form-control-lg" placeholder="Nhập mật khẩu" autocomplete="current-password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label class="form-check">
                                    <input asp-for="RememberMe" class="form-check-input" />
                                    <span class="form-check-label">Ghi nhớ đăng nhập</span>
                                </label>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100">Đăng nhập</button>
                        </form>
                    </section>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/zuramai/mazer@@docs/demo/assets/static/js/components/dark.js"></script>
</body>
</html>
