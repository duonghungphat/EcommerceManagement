@model EcommerceManagement.Core.ViewModels.ChangePasswordViewModel

@{
    Layout = "~/Areas/Management/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="page-heading mb-4">
    <h3 class="mb-1">Đổi mật khẩu</h3>
    <p class="text-muted mb-0">Nhập mật khẩu hiện tại trước khi đặt mật khẩu mới.</p>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-controller="Account" asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="mb-3">
                <label asp-for="OldPassword" class="form-label">Mật khẩu hiện tại</label>
                <input asp-for="OldPassword" type="password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="OldPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
                <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
                <a asp-area="Management" asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
