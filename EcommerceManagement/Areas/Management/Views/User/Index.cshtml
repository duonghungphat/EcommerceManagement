@using System.Security.Claims
@model IEnumerable<UserListItemViewModel>

@{
    ViewData["Title"] = "Tài khoản";
    int currentUserId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!);
}

<h2>Danh sách tài khoản</h2>

<a asp-action="Create"
   class="btn btn-primary mb-3">
    Tạo tài khoản
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Vai trò</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@item.RoleDisplayName</td>

                <td>
                    @(item.IsActive ? "Đang hoạt động" : "Đã khóa")
                </td>

                <td>
                    @if (item.Id != currentUserId)
                    {
                        <a asp-action="EditRole"
                           asp-route-id="@item.Id">
                            Đổi vai trò
                        </a>

                        <span> | </span>

                        <a asp-action="ResetPassword"
                           asp-route-id="@item.Id">
                            Đặt lại mật khẩu
                        </a>

                        <span> | </span>

                        <form asp-action="ToggleActive"
                              method="post"
                              class="d-inline">

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <button type="submit"
                                    class="btn btn-link p-0">
                                @(item.IsActive ? "Khóa" : "Mở khóa")
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">
                            Tài khoản hiện tại
                        </span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>