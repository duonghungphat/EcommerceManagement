@model EcommerceManagement.Core.ViewModels.UserRoleViewModel

@{
    ViewData["Title"] = "Cập nhật vai trò";
}

<div class="page-heading mb-4">
    <h3 class="mb-1">Cập nhật vai trò</h3>
    <p class="text-muted mb-0">Thay đổi quyền sử dụng cho tài khoản nội bộ.</p>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="EditRole" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="mb-3">
                <label class="form-label">Họ tên</label>
                <input value="@Model.FullName" class="form-control" disabled />
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input value="@Model.Email" class="form-control" disabled />
            </div>

            <div class="mb-4">
                <label asp-for="RoleId" class="form-label">Vai trò</label>
                <select asp-for="RoleId" class="form-select">
                    <option value="">-- Chọn vai trò --</option>
                    @foreach (var role in Model.Roles)
                    {
                        <option value="@role.Id">@role.DisplayName</option>
                    }
                </select>
                <span asp-validation-for="RoleId" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Cập nhật</button>
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
