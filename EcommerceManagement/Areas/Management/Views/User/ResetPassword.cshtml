@model EcommerceManagement.Core.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<h2>Đặt lại mật khẩu</h2>

<p>
    Tài khoản:
    <strong>@Model.FullName</strong>
</p>

<form asp-action="ResetPassword"
      method="post">

    <input asp-for="UserId"
           type="hidden" />

    <input asp-for="FullName"
           type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">
        <label asp-for="NewPassword"
               class="form-label">
            Mật khẩu mới
        </label>

        <input asp-for="NewPassword"
               type="password"
               class="form-control" />

        <span asp-validation-for="NewPassword"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword"
               class="form-label">
            Xác nhận mật khẩu mới
        </label>

        <input asp-for="ConfirmPassword"
               type="password"
               class="form-control" />

        <span asp-validation-for="ConfirmPassword"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Đặt lại mật khẩu
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Quay lại
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}