@model ProductViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="page-heading mb-4">
    <h3 class="mb-1">Sửa sản phẩm</h3>
    <p class="text-muted mb-0">Cập nhật sản phẩm, thuộc tính và các biến thể.</p>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" id="productForm">

            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                    <small class="text-muted d-block mt-1">Nhập tên chung của sản phẩm, ví dụ: iPhone 14. Không thêm màu, dung lượng, size... nếu các thông tin đó đã được quản lý bằng biến thể.</small>
                </div>

                <div class="col-md-4">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<ProductStatus>()" class="form-select"></select>
                </div>

                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label">Danh mục</label>
                    <select asp-for="CategoryId" class="form-select" id="categorySelect">
                        <option value="0">-- Chọn danh mục --</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Ảnh chung của sản phẩm</label>

                    @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImagePath" alt="@Model.Name" style="width: 110px; height: 110px; object-fit: cover;" class="rounded border" />
                        </div>
                    }

                    <input type="file" name="imageFile" accept=".jpg,.jpeg,.png" class="form-control" />
                    <small class="text-muted">Ảnh đại diện chung của sản phẩm. Ảnh này không xác định màu/size/dung lượng; biến thể có thể dùng ảnh riêng và fallback về ảnh này.</small>
                </div>
            </div>

            <hr class="my-4" />

            <div id="productAttributeSection">
                <h5 class="mb-1">Thông tin phân loại chung</h5>
                <p class="text-muted mb-3">
                    Chỉ chứa thông tin áp dụng cho toàn bộ sản phẩm như Hãng, Nhu cầu, Đối tượng.
                    Bộ thuộc tính được lấy theo danh mục đã chọn.
                </p>

                <div id="productAttributeFields" class="row g-3">
                    @for (int i = 0; i < Model.ProductAttributes.Count; i++)
                    {
                        var attr = Model.ProductAttributes[i];

                        <input type="hidden" name="ProductAttributes[@i].DefinitionId" value="@attr.DefinitionId" />

                        <div class="col-md-6">
                            <label class="form-label">
                                @attr.Name
                                @if (attr.IsRequired)
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>

                            @if (attr.AllowMultipleValues)
                            {
                                <div class="border rounded p-3">
                                    @foreach (var value in attr.Values)
                                    {
                                        bool isChecked = attr.SelectedValueIds.Contains(value.Id);

                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="ProductAttributes[@i].SelectedValueIds"
                                                   value="@value.Id"
                                                   checked="@isChecked" />
                                            <label class="form-check-label">@value.Value</label>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <select name="ProductAttributes[@i].SelectedValueIds"
                                        class="form-select">
                                    <option value="">-- Không chọn --</option>

                                    @foreach (var value in attr.Values)
                                    {
                                        bool selected = attr.SelectedValueIds.Contains(value.Id);

                                        if (selected)
                                        {
                                            <option value="@value.Id" selected>@value.Value</option>
                                        }
                                        else
                                        {
                                            <option value="@value.Id">@value.Value</option>
                                        }
                                    }
                                </select>
                            }
                        </div>
                    }
                </div>

                <div id="noProductAttributes"
                     class="alert alert-light @(Model.ProductAttributes.Any() ? "d-none" : "")">
                    Danh mục này chưa được cấu hình thuộc tính thông tin chung.
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <h5 class="mb-1">Thuộc tính tạo biến thể</h5>
                    <p class="text-muted mb-0">Chọn các giá trị cần bán rồi tạo tổ hợp. Ví dụ 256GB + Xanh hoặc Size M + Đen.</p>
                </div>

                <button type="button" class="btn btn-success" id="generateVariantsButton">Tạo tổ hợp biến thể</button>
            </div>

            <div id="variantAttributeSection">
                <div id="variantAttributeBuilder" class="row g-3 mb-4">
                    @for (int i = 0; i < Model.VariantAttributes.Count; i++)
                    {
                        var attr = Model.VariantAttributes[i];

                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="fw-semibold mb-2">
                                    @attr.Name
                                    @if (attr.IsRequired)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </div>

                                <input type="hidden" name="VariantAttributes[@i].DefinitionId" value="@attr.DefinitionId" />

                                <div class="d-flex flex-wrap gap-3">
                                    @foreach (var value in attr.Values)
                                    {
                                        bool isChecked = attr.SelectedValueIds.Contains(value.Id);

                                        <div class="form-check">
                                            <input class="form-check-input variant-builder-value"
                                                   type="checkbox"
                                                   name="VariantAttributes[@i].SelectedValueIds"
                                                   value="@value.Id"
                                                   data-definition-id="@attr.DefinitionId"
                                                   data-label="@value.Value"
                                                   checked="@isChecked" />
                                            <label class="form-check-label">@value.Value</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div id="noVariantAttributes"
                     class="alert alert-light @(Model.VariantAttributes.Any() ? "d-none" : "")">
                    Danh mục này chưa được cấu hình thuộc tính tạo biến thể. Sản phẩm có thể dùng một biến thể mặc định.
                </div>

                <div id="categoryAttributeWarning" class="alert alert-warning d-none">
                    Danh mục đã thay đổi. Hãy chọn lại thuộc tính và bấm <strong>Tạo tổ hợp biến thể</strong> trước khi lưu.
                </div>
            </div>

            <div id="variantContainer">
                @for (int i = 0; i < Model.Variants.Count; i++)
                {
                    var variant = Model.Variants[i];
                    string displayName = string.IsNullOrWhiteSpace(variant.Name) ? "Mặc định" : variant.Name;

                    <div class="variant-row border rounded p-3 mb-3">
                        <input asp-for="Variants[i].Id" type="hidden" class="variant-id" />
                        <input asp-for="Variants[i].OriginalStockQuantity" type="hidden" class="variant-original-stock" />
                        <input asp-for="Variants[i].ProductId" type="hidden" class="variant-product-id" />
                        <input asp-for="Variants[i].ImagePath" type="hidden" class="variant-image-path" />

                        @foreach (int valueId in variant.AttributeValueIds)
                        {
                            <input type="hidden" name="Variants[@i].AttributeValueIds" value="@valueId" class="variant-attribute-value" />
                        }

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="variant-title fw-bold">@displayName</div>
                            <button type="button" class="btn btn-danger btn-sm remove-variant">Xóa biến thể</button>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">SKU</label>
                                <input asp-for="Variants[i].SKU" class="form-control variant-sku" />
                                <span asp-validation-for="Variants[i].SKU" class="text-danger small variant-sku-error"></span>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Giá</label>
                                <input asp-for="Variants[i].Price" type="number" min="0.01" step="0.01" class="form-control variant-price" />
                                <span asp-validation-for="Variants[i].Price" class="text-danger small variant-price-error"></span>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Tồn kho</label>
                                <input asp-for="Variants[i].StockQuantity" type="number" min="0" class="form-control variant-stock" />
                                <span asp-validation-for="Variants[i].StockQuantity" class="text-danger small variant-stock-error"></span>
                            </div>

                            <div class="col-md-5">
                                <label class="form-label">Ảnh riêng của biến thể</label>

                                @if (!string.IsNullOrWhiteSpace(variant.ImagePath))
                                {
                                    <div class="mb-2">
                                        <img src="@variant.ImagePath"
                                             alt="@displayName"
                                             style="width: 80px; height: 80px; object-fit: cover;"
                                             class="rounded border" />
                                    </div>
                                }

                                <input type="file" name="variantImages[@i]" accept=".jpg,.jpeg,.png" class="form-control variant-image-file" />
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Cập nhật</button>
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const variantContainer = document.getElementById("variantContainer");
        const generateVariantsButton = document.getElementById("generateVariantsButton");
        const categorySelect = document.getElementById("categorySelect");
        const productAttributeFields = document.getElementById("productAttributeFields");
        const noProductAttributes = document.getElementById("noProductAttributes");
        const variantAttributeBuilder = document.getElementById("variantAttributeBuilder");
        const noVariantAttributes = document.getElementById("noVariantAttributes");
        const categoryAttributeWarning = document.getElementById("categoryAttributeWarning");
        const productForm = document.getElementById("productForm");

        let previousCategoryId = categorySelect.value;
        let categoryAttributesDirty = false;

        function escapeHtml(value) {
            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        function renderProductAttributes(attributes) {
            productAttributeFields.innerHTML = "";

            attributes.forEach((attr, index) => {
                const column = document.createElement("div");
                column.className = "col-md-6";

                const requiredMark = attr.isRequired ? '<span class="text-danger">*</span>' : "";
                let controlHtml = "";

                if (attr.allowMultipleValues) {
                    const values = attr.values.map(value => `
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="ProductAttributes[${index}].SelectedValueIds"
                                   value="${value.id}" />
                            <label class="form-check-label">${escapeHtml(value.value)}</label>
                        </div>`).join("");

                    controlHtml = `<div class="border rounded p-3">${values}</div>`;
                }
                else {
                    const required = attr.isRequired ? "required" : "";
                    const options = attr.values
                        .map(value => `<option value="${value.id}">${escapeHtml(value.value)}</option>`)
                        .join("");

                    controlHtml = `
                        <select name="ProductAttributes[${index}].SelectedValueIds"
                                class="form-select"
                                ${required}>
                            <option value="">-- Không chọn --</option>
                            ${options}
                        </select>`;
                }

                column.innerHTML = `
                    <input type="hidden"
                           name="ProductAttributes[${index}].DefinitionId"
                           value="${attr.definitionId}" />
                    <label class="form-label">${escapeHtml(attr.name)} ${requiredMark}</label>
                    ${controlHtml}`;

                productAttributeFields.appendChild(column);
            });

            noProductAttributes.classList.toggle("d-none", attributes.length > 0);
        }

        function renderVariantAttributes(attributes) {
            variantAttributeBuilder.innerHTML = "";

            attributes.forEach((attr, index) => {
                const column = document.createElement("div");
                column.className = "col-md-6";

                const requiredMark = attr.isRequired ? '<span class="text-danger">*</span>' : "";
                const values = attr.values.map(value => `
                    <div class="form-check">
                        <input class="form-check-input variant-builder-value"
                               type="checkbox"
                               name="VariantAttributes[${index}].SelectedValueIds"
                               value="${value.id}"
                               data-definition-id="${attr.definitionId}"
                               data-label="${escapeHtml(value.value)}" />
                        <label class="form-check-label">${escapeHtml(value.value)}</label>
                    </div>`).join("");

                column.innerHTML = `
                    <div class="border rounded p-3 h-100">
                        <div class="fw-semibold mb-2">${escapeHtml(attr.name)} ${requiredMark}</div>
                        <input type="hidden"
                               name="VariantAttributes[${index}].DefinitionId"
                               value="${attr.definitionId}" />
                        <div class="d-flex flex-wrap gap-3">
                            ${values}
                        </div>
                    </div>`;

                variantAttributeBuilder.appendChild(column);
            });

            noVariantAttributes.classList.toggle("d-none", attributes.length > 0);
        }

        async function loadCategoryAttributes(categoryId) {
            if (!categoryId || Number(categoryId) <= 0) {
                renderProductAttributes([]);
                renderVariantAttributes([]);
                return;
            }

            const response = await fetch(`@Url.Action("GetCategoryAttributes", "Product", new { area = "Management" })?categoryId=${categoryId}`);

            if (!response.ok)
                throw new Error("Không thể tải bộ thuộc tính của danh mục.");

            const data = await response.json();
            renderProductAttributes(data.productAttributes || []);
            renderVariantAttributes(data.variantAttributes || []);
            refreshValidation();
        }

        categorySelect.addEventListener("change", async () => {
            const newCategoryId = categorySelect.value;

            if (newCategoryId === previousCategoryId)
                return;

            const hasSavedVariant = Array.from(document.querySelectorAll(".variant-id"))
                .some(input => Number(input.value) > 0);

            if (hasSavedVariant) {
                const confirmed = confirm(
                    "Đổi danh mục sẽ thay đổi bộ thuộc tính của sản phẩm. " +
                    "Bạn cần tạo lại tổ hợp biến thể trước khi lưu. Tiếp tục?"
                );

                if (!confirmed) {
                    categorySelect.value = previousCategoryId;
                    return;
                }
            }

            try {
                await loadCategoryAttributes(newCategoryId);
                previousCategoryId = newCategoryId;
                categoryAttributesDirty = true;
                categoryAttributeWarning.classList.remove("d-none");
            }
            catch (error) {
                alert(error.message || "Không thể tải thuộc tính danh mục.");
                categorySelect.value = previousCategoryId;
            }
        });

        productForm.addEventListener("submit", event => {
            if (!categoryAttributesDirty)
                return;

            event.preventDefault();
            alert("Bạn đã đổi danh mục. Hãy bấm Tạo tổ hợp biến thể trước khi lưu.");
        });


        function refreshValidation() {
            const form = $("#productForm");
            form.removeData("validator");
            form.removeData("unobtrusiveValidation");
            $.validator.unobtrusive.parse(form);
        }

        function getRowKey(row) {
            const ids = Array.from(row.querySelectorAll(".variant-attribute-value"))
                .map(input => Number(input.value))
                .sort((a, b) => a - b);

            return ids.length === 0 ? "default" : ids.join("-");
        }

        function setRowKey(row) {
            row.dataset.comboKey = getRowKey(row);
        }

        function createCartesian(groups) {
            if (groups.length === 0)
                return [{ values: [], label: "Mặc định" }];

            let combinations = [{ values: [], labels: [] }];

            groups.forEach(group => {
                const next = [];

                combinations.forEach(current => {
                    group.values.forEach(value => {
                        next.push({
                            values: [...current.values, value.id],
                            labels: [...current.labels, value.label]
                        });
                    });
                });

                combinations = next;
            });

            return combinations.map(combo => ({
                values: combo.values,
                label: combo.labels.join(" / ")
            }));
        }

        function getSelectedGroups() {
            const map = new Map();

            document.querySelectorAll(".variant-builder-value:checked").forEach(input => {
                const definitionId = Number(input.dataset.definitionId);

                if (!map.has(definitionId))
                    map.set(definitionId, []);

                map.get(definitionId).push({
                    id: Number(input.value),
                    label: input.dataset.label
                });
            });

            return Array.from(map.entries()).map(([definitionId, values]) => ({
                definitionId,
                values
            }));
        }

        function createNewRow(combo) {
            const row = document.createElement("div");
            row.className = "variant-row border rounded p-3 mb-3";

            const hiddenAttributes = combo.values
                .map(valueId => `<input type="hidden" value="${valueId}" class="variant-attribute-value" />`)
                .join("");

            row.innerHTML = `
                <input type="hidden" value="0" class="variant-id" />
                <input type="hidden" value="0" class="variant-original-stock" />
                <input type="hidden" value="@Model.Id" class="variant-product-id" />
                <input type="hidden" value="" class="variant-image-path" />

                ${hiddenAttributes}

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="variant-title fw-bold">${combo.label}</div>
                    <button type="button" class="btn btn-danger btn-sm remove-variant">Xóa biến thể</button>
                </div>

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">SKU</label>
                        <input class="form-control variant-sku"
                               data-val="true"
                               data-val-required="SKU không được để trống."
                               data-val-length="SKU tối đa 100 ký tự."
                               data-val-length-max="100" />
                        <span class="text-danger small variant-sku-error field-validation-valid"
                              data-valmsg-replace="true"></span>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Giá</label>
                        <input type="number"
                               min="0.01"
                               step="0.01"
                               class="form-control variant-price"
                               data-val="true"
                               data-val-range="Giá biến thể phải lớn hơn 0."
                               data-val-range-min="0.01"
                               data-val-range-max="9999999999999999" />
                        <span class="text-danger small variant-price-error field-validation-valid"
                              data-valmsg-replace="true"></span>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Tồn kho</label>
                        <input type="number"
                               min="0"
                               value="0"
                               class="form-control variant-stock"
                               data-val="true"
                               data-val-range="Số lượng tồn kho không được âm."
                               data-val-range-min="0"
                               data-val-range-max="2147483647" />
                        <span class="text-danger small variant-stock-error field-validation-valid"
                              data-valmsg-replace="true"></span>
                    </div>

                    <div class="col-md-5">
                        <label class="form-label">Ảnh riêng của biến thể</label>
                        <input type="file" accept=".jpg,.jpeg,.png" class="form-control variant-image-file" />
                    </div>
                </div>`;

            setRowKey(row);
            bindRemove(row);

            return row;
        }

        function renumberVariants() {
            document.querySelectorAll(".variant-row").forEach((row, index) => {
                row.querySelector(".variant-id").name = `Variants[${index}].Id`;
                row.querySelector(".variant-original-stock").name = `Variants[${index}].OriginalStockQuantity`;
                row.querySelector(".variant-product-id").name = `Variants[${index}].ProductId`;
                row.querySelector(".variant-image-path").name = `Variants[${index}].ImagePath`;

                row.querySelectorAll(".variant-attribute-value").forEach(input => {
                    input.name = `Variants[${index}].AttributeValueIds`;
                });

                const sku = row.querySelector(".variant-sku");
                sku.name = `Variants[${index}].SKU`;
                sku.id = `Variants_${index}__SKU`;

                const price = row.querySelector(".variant-price");
                price.name = `Variants[${index}].Price`;
                price.id = `Variants_${index}__Price`;

                const stock = row.querySelector(".variant-stock");
                stock.name = `Variants[${index}].StockQuantity`;
                stock.id = `Variants_${index}__StockQuantity`;

                row.querySelector(".variant-image-file").name = `variantImages[${index}]`;

                const skuError = row.querySelector(".variant-sku-error");
                const priceError = row.querySelector(".variant-price-error");
                const stockError = row.querySelector(".variant-stock-error");

                skuError?.setAttribute("data-valmsg-for", `Variants[${index}].SKU`);
                priceError?.setAttribute("data-valmsg-for", `Variants[${index}].Price`);
                stockError?.setAttribute("data-valmsg-for", `Variants[${index}].StockQuantity`);

                setRowKey(row);
            });

            updateRemoveButtons();
            refreshValidation();
        }

        function updateRemoveButtons() {
            const rows = document.querySelectorAll(".variant-row");

            rows.forEach(row => {
                row.querySelector(".remove-variant").disabled = rows.length <= 1;
            });
        }

        function bindRemove(row) {
            row.querySelector(".remove-variant").addEventListener("click", () => {
                if (document.querySelectorAll(".variant-row").length <= 1) {
                    alert("Sản phẩm phải có ít nhất một biến thể.");
                    return;
                }

                row.remove();
                renumberVariants();
            });
        }

        generateVariantsButton.addEventListener("click", () => {
            const groups = getSelectedGroups();
            const combinations = createCartesian(groups);

            const existingRows = new Map();

            document.querySelectorAll(".variant-row").forEach(row => {
                setRowKey(row);
                existingRows.set(row.dataset.comboKey, row);
            });

            variantContainer.innerHTML = "";

            combinations.forEach(combo => {
                const key = combo.values.length === 0
                    ? "default"
                    : [...combo.values].sort((a, b) => a - b).join("-");

                let row = existingRows.get(key);

                if (!row)
                    row = createNewRow(combo);
                else
                    row.querySelector(".variant-title").textContent = combo.label;

                variantContainer.appendChild(row);
            });

            renumberVariants();
            categoryAttributesDirty = false;
            categoryAttributeWarning.classList.add("d-none");
        });

        document.querySelectorAll(".variant-row").forEach(row => {
            setRowKey(row);
            bindRemove(row);
        });

        renumberVariants();
    </script>
}
