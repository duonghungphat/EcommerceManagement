@model AuditLogListViewModel

@{
    ViewData["Title"] = "Nhật ký hệ thống";
}

<div class="page-heading mb-4">
    <div>
        <h3 class="mb-1">Nhật ký hệ thống</h3>
        <p class="text-muted mb-0">Theo dõi các thao tác quan trọng được thực hiện trong hệ thống.</p>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end crud-filter">
            <div class="col-lg-4 col-md-6">
                <select asp-for="UserId" class="form-select">
                    <option value="">-- Tất cả người dùng --</option>
                    @foreach (var user in Model.Users)
                    {
                        <option value="@user.Id">@user.FullName</option>
                    }
                </select>
            </div>

            <div class="col-lg-3 col-md-6">
                <label asp-for="FromDate" class="form-label small text-muted">Từ ngày</label>
                <input asp-for="FromDate" type="date" class="form-control" />
            </div>

            <div class="col-lg-3 col-md-6">
                <label asp-for="ToDate" class="form-label small text-muted">Đến ngày</label>
                <input asp-for="ToDate" type="date" class="form-control" />
            </div>

            <div class="col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Lọc</button>
                <a asp-action="Index" class="btn btn-secondary">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Thời điểm</th>
                    <th>Người thực hiện</th>
                    <th>Hành động</th>
                    <th>Đối tượng</th>
                    <th>Mô tả</th>
                    <th>Địa chỉ IP</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Logs.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Chưa có nhật ký phù hợp.</td>
                    </tr>
                }

                @foreach (var item in Model.Logs)
                {
                    <tr>
                        <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="fw-semibold">@item.UserName</td>
                        <td><span class="badge bg-primary">@item.ActionText</span></td>
                        <td>
                            @item.EntityNameText
                            @if (item.EntityId.HasValue)
                            {
                                <span class="text-muted">#@item.EntityId</span>
                            }
                        </td>
                        <td>@item.Description</td>
                        <td><code>@item.IpAddress</code></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
