@model AuditLogListViewModel

@{
    ViewData["Title"] = "Nhật ký hệ thống";
}

<h2>Nhật ký hệ thống</h2>

<form method="get"
      asp-action="Index"
      class="row g-2 mb-3">

    <div class="col-md-4">

        <select asp-for="UserId"
                class="form-select">

            <option value="">
                -- Tất cả người dùng --
            </option>

            @foreach (var user in Model.Users)
            {
                <option value="@user.Id">
                    @user.FullName
                </option>
            }

        </select>

    </div>

    <div class="col-md-3">

        <input asp-for="FromDate"
               type="date"
               class="form-control" />

    </div>

    <div class="col-md-3">

        <input asp-for="ToDate"
               type="date"
               class="form-control" />

    </div>

    <div class="col-md-2">

        <button type="submit"
                class="btn btn-primary">
            Lọc
        </button>

    </div>

</form>


<table class="table table-bordered">

    <thead>
        <tr>
            <th>Thời điểm</th>
            <th>Người thực hiện</th>
            <th>Hành động</th>
            <th>Đối tượng</th>
            <th>Mô tả</th>
            <th>Địa chỉ IP</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.Logs)
        {
            <tr>
                <td>
                    @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </td>

                <td>
                    @item.UserName
                </td>

                <td>
                    @item.ActionText
                </td>

                <td>
                    @item.EntityNameText

                    @if (item.EntityId.HasValue)
                    {
                        <span>
                            #@item.EntityId
                        </span>
                    }
                </td>

                <td>
                    @item.Description
                </td>

                <td>
                    @item.IpAddress
                </td>
            </tr>
        }

    </tbody>

</table>