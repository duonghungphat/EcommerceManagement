@model OrderCreateViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Tạo đơn hàng";
}

<div class="page-heading mb-4">
    <h3 class="mb-1">Tạo đơn hàng</h3>
    <p class="text-muted mb-0">Chọn khách hàng và biến thể sản phẩm cần đặt.</p>
</div>

<div class="card order-create-card">
    <div class="card-body">
        <form id="orderForm" asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="CustomerId" class="form-label">Khách hàng</label>

                <div class="d-flex gap-2">
                    <select asp-for="CustomerId" class="form-select">
                        <option value="">-- Chọn khách hàng --</option>

                        @foreach (var customer in Model.Customers)
                        {
                            <option value="@customer.Id">@customer.FullName - @customer.PhoneNumber</option>
                        }
                    </select>

                    <button type="button" class="btn btn-success text-nowrap" data-bs-toggle="modal" data-bs-target="#quickCustomerModal">
                        Thêm khách hàng
                    </button>
                </div>

                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Note" class="form-label">Ghi chú</label>
                <textarea asp-for="Note" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>

            <hr />

            <div class="d-flex justify-content-between align-items-center mb-2">
                <h4>Sản phẩm</h4>
                <button type="button" id="addProductButton" class="btn btn-success">Thêm dòng sản phẩm</button>
            </div>

            <div id="orderItems">
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    <div class="order-item row g-2 mb-3">
                        <div class="col-md-5">
                            <label class="form-label">Sản phẩm / biến thể</label>

                            <select asp-for="Items[i].ProductVariantId" class="form-select variant-select">
                                <option value="">-- Chọn biến thể sản phẩm --</option>

                                @foreach (var variant in Model.ProductVariants)
                                {
                                    <option value="@variant.Id"
                                            data-price="@variant.Price"
                                            data-stock="@variant.StockQuantity">
                                        @variant.ProductName - @variant.VariantName (@variant.SKU) - @variant.Price.ToString("N0") đ - Tồn: @variant.StockQuantity
                                    </option>
                                }
                            </select>

                            <span asp-validation-for="Items[i].ProductVariantId" class="text-danger variant-error"></span>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Số lượng</label>
                            <input asp-for="Items[i].Quantity" type="number" min="1" class="form-control quantity-input" />
                            <span asp-validation-for="Items[i].Quantity" class="text-danger quantity-error"></span>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Đơn giá</label>
                            <input type="text" class="form-control unit-price" readonly />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Thành tiền</label>
                            <input type="text" class="form-control line-total" readonly />
                        </div>

                        <div class="col-md-1 d-flex align-items-end">
                            <button type="button" class="btn btn-danger remove-item">Xóa</button>
                        </div>
                    </div>
                }
            </div>

            <hr />

            <div class="text-end mb-3">
                <strong>Tổng tiền:</strong>
                <span id="orderTotal" class="fs-5">0 đ</span>
            </div>

            <button type="submit" class="btn btn-primary">Tạo đơn hàng</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>

<div class="modal fade" id="quickCustomerModal" tabindex="-1" aria-labelledby="quickCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="quickCustomerForm" asp-area="Management" asp-controller="Customer" asp-action="QuickCreate" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="quickCustomerModalLabel">Thêm khách hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <div class="modal-body">
                    <div id="quickCustomerError" class="alert alert-danger d-none"></div>

                    <div class="mb-3">
                        <label class="form-label">Tên khách hàng</label>
                        <input name="FullName" type="text" class="form-control" maxlength="100" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input name="Email" type="email" class="form-control" maxlength="100" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Số điện thoại</label>
                        <input name="PhoneNumber" type="text" class="form-control" maxlength="10" pattern="[0-9]{9,10}" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Địa chỉ</label>
                        <input name="Address" type="text" class="form-control" maxlength="200" required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Lưu khách hàng</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const variants = @Html.Raw(JsonSerializer.Serialize(Model.ProductVariants.Select(v => new
        {
                id = v.Id,
                productName = v.ProductName,
                variantName = v.VariantName,
                sku = v.SKU,
                price = v.Price,
                stock = v.StockQuantity
        })));

    const orderItemsContainer = document.getElementById("orderItems");
    const addProductButton = document.getElementById("addProductButton");

        function formatMoney(value) {
            return new Intl.NumberFormat("vi-VN").format(value) + " đ";
        }

        function escapeHtml(value) {
            return String(value)
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        function createOptions() {
            let html = '<option value="">-- Chọn biến thể sản phẩm --</option>';

            variants.forEach(variant => {
                const label = `${variant.productName} - ${variant.variantName} (${variant.sku}) - ${formatMoney(variant.price)} - Tồn: ${variant.stock}`;

                html += `<option value="${variant.id}" data-price="${variant.price}" data-stock="${variant.stock}">${escapeHtml(label)}</option>`;
            });

            return html;
        }

        function refreshValidation() {
            const form = $("#orderForm");
            form.removeData("validator");
            form.removeData("unobtrusiveValidation");
            $.validator.unobtrusive.parse(form);
        }

        function renumberItems() {
            document.querySelectorAll(".order-item").forEach((row, index) => {
                const variant = row.querySelector(".variant-select");
                const quantity = row.querySelector(".quantity-input");
                const variantError = row.querySelector(".variant-error");
                const quantityError = row.querySelector(".quantity-error");

                const variantName = `Items[${index}].ProductVariantId`;
                const quantityName = `Items[${index}].Quantity`;

                variant.name = variantName;
                variant.id = `Items_${index}__ProductVariantId`;

                quantity.name = quantityName;
                quantity.id = `Items_${index}__Quantity`;

                variantError?.setAttribute("data-valmsg-for", variantName);
                quantityError?.setAttribute("data-valmsg-for", quantityName);
            });

            refreshValidation();
        }

        function updateTotal() {
            let total = 0;

            document.querySelectorAll(".order-item").forEach(row => {
                const selectedOption = row.querySelector(".variant-select").selectedOptions[0];
                const price = parseFloat(selectedOption?.dataset.price || 0);
                const quantity = parseInt(row.querySelector(".quantity-input").value || 0);

                total += price * quantity;
            });

            document.getElementById("orderTotal").textContent = formatMoney(total);
        }

        function updateRow(row) {
            const selectedOption = row.querySelector(".variant-select").selectedOptions[0];
            const price = parseFloat(selectedOption?.dataset.price || 0);
            const quantity = parseInt(row.querySelector(".quantity-input").value || 0);

            row.querySelector(".unit-price").value = formatMoney(price);
            row.querySelector(".line-total").value = formatMoney(price * quantity);

            updateTotal();
        }

        function bindRow(row) {
            row.querySelector(".variant-select").addEventListener("change", () => updateRow(row));
            row.querySelector(".quantity-input").addEventListener("input", () => updateRow(row));

            row.querySelector(".remove-item").addEventListener("click", () => {
                const rows = document.querySelectorAll(".order-item");

                if (rows.length <= 1) {
                    alert("Đơn hàng phải có ít nhất một dòng sản phẩm.");
                    return;
                }

                row.remove();
                renumberItems();
                updateTotal();
            });

            updateRow(row);
        }

        addProductButton.addEventListener("click", () => {
            const index = document.querySelectorAll(".order-item").length;
            const row = document.createElement("div");

            row.className = "order-item row g-2 mb-3";
            row.innerHTML = `
                <div class="col-md-5">
                    <label class="form-label">Sản phẩm / biến thể</label>

                    <select name="Items[${index}].ProductVariantId"
                            id="Items_${index}__ProductVariantId"
                            class="form-select variant-select"
                            data-val="true"
                            data-val-range="Vui lòng chọn biến thể sản phẩm."
                            data-val-range-min="1"
                            data-val-range-max="2147483647">
                        ${createOptions()}
                    </select>

                    <span class="text-danger variant-error field-validation-valid"
                          data-valmsg-for="Items[${index}].ProductVariantId"
                          data-valmsg-replace="true"></span>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Số lượng</label>

                    <input name="Items[${index}].Quantity"
                           id="Items_${index}__Quantity"
                           type="number"
                           min="1"
                           value="1"
                           class="form-control quantity-input"
                           data-val="true"
                           data-val-range="Số lượng phải từ 1 trở lên."
                           data-val-range-min="1"
                           data-val-range-max="2147483647" />

                    <span class="text-danger quantity-error field-validation-valid"
                          data-valmsg-for="Items[${index}].Quantity"
                          data-valmsg-replace="true"></span>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Đơn giá</label>
                    <input type="text" class="form-control unit-price" readonly />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Thành tiền</label>
                    <input type="text" class="form-control line-total" readonly />
                </div>

                <div class="col-md-1 d-flex align-items-end">
                    <button type="button" class="btn btn-danger remove-item">Xóa</button>
                </div>`;

            orderItemsContainer.appendChild(row);
            bindRow(row);
            refreshValidation();
        });

        document.querySelectorAll(".order-item").forEach(row => bindRow(row));
        refreshValidation();

        const quickCustomerForm = document.getElementById("quickCustomerForm");
        const quickCustomerError = document.getElementById("quickCustomerError");

        quickCustomerForm.addEventListener("submit", async event => {
            event.preventDefault();

            quickCustomerError.classList.add("d-none");
            quickCustomerError.textContent = "";

            const submitButton = quickCustomerForm.querySelector('button[type="submit"]');
            submitButton.disabled = true;

            try {
                const response = await fetch(quickCustomerForm.action, {
                    method: "POST",
                    body: new FormData(quickCustomerForm)
                });

                const result = await response.json();

                if (!response.ok) {
                    const messages = [];

                    if (result.message)
                        messages.push(result.message);

                    if (result.errors)
                        Object.values(result.errors).flat().forEach(error => messages.push(error));

                    quickCustomerError.textContent = messages.join("\n") || "Không thể tạo khách hàng.";
                    quickCustomerError.style.whiteSpace = "pre-line";
                    quickCustomerError.classList.remove("d-none");
                    return;
                }

                const customerSelect = document.getElementById("CustomerId");
                customerSelect.add(new Option(
                    `${result.customer.fullName} - ${result.customer.phoneNumber}`,
                    result.customer.id,
                    true,
                    true
                ));

                quickCustomerForm.reset();
                bootstrap.Modal.getOrCreateInstance(document.getElementById("quickCustomerModal")).hide();
            }
            catch {
                quickCustomerError.textContent = "Không thể tạo khách hàng. Vui lòng thử lại.";
                quickCustomerError.classList.remove("d-none");
            }
            finally {
                submitButton.disabled = false;
            }
        });

        document.getElementById("quickCustomerModal").addEventListener("hidden.bs.modal", () => {
            quickCustomerError.classList.add("d-none");
            quickCustomerError.textContent = "";
        });
    </script>
}
