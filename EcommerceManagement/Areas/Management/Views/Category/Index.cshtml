@model IEnumerable<CategoryViewModel>

@{
    ViewData["Title"] = "Danh mục";
}

<style>
    .category-child-row > td {
        background-color: rgba(var(--bs-primary-rgb), 0.08) !important;
    }

        .category-child-row > td:first-child {
            border-left: 3px solid var(--bs-primary) !important;
        }

        .category-child-row > td:nth-child(2) {
            color: var(--bs-primary);
            font-weight: 600;
            padding-left: 1.5rem !important;
        }
</style>

<div class="page-heading mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <h3 class="mb-1">Danh sách danh mục</h3>
            <p class="text-muted mb-0">Quản lý nhóm sản phẩm trong hệ thống.</p>
        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a asp-action="Create" class="btn btn-primary">Thêm danh mục</a>
        }
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tên danh mục</th>
                    <th>Danh mục cha</th>
                    <th>Mô tả</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Chưa có danh mục.</td>
                    </tr>
                }

                @foreach (var item in Model)
                {
                    <tr class="@(item.ParentCategoryId.HasValue ? "category-child-row" : "")">
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@(item.ParentCategoryName ?? "-")</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)</td>

                        <td class="text-end">
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                            {
                                <div class="crud-actions">
                                    <a asp-action="Attributes" asp-route-id="@item.Id" class="btn btn-info btn-sm">Thuộc tính</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>

                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này?');">
                                        <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-light-secondary">Chỉ xem</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>