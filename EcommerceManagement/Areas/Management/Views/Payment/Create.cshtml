@using EcommerceManagement.Core.Enums
@model EcommerceManagement.Core.ViewModels.PaymentCreateViewModel

@{
    ViewData["Title"] = "Ghi nhận thanh toán";
}

<h2>Ghi nhận thanh toán</h2>

<p>
    Mã đơn:
    <strong>@Model.OrderCode</strong>
</p>

<p>
    Công nợ còn lại:
    <strong>
        @Model.RemainingAmount.ToString("N0") đ
    </strong>
</p>


<form asp-action="Create"
      method="post">

    <input asp-for="OrderId"
           type="hidden" />

    <input asp-for="OrderCode"
           type="hidden" />

    <input asp-for="RemainingAmount"
           type="hidden" />


    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <div class="mb-3">

        <label asp-for="Amount"
               class="form-label">

            Số tiền

        </label>

        <input asp-for="Amount"
               type="number"
               step="0.01"
               min="0.01"
               max="@Model.RemainingAmount"
               class="form-control" />

        <span asp-validation-for="Amount"
              class="text-danger">
        </span>

    </div>


    <div class="mb-3">

        <label asp-for="PaymentMethod"
               class="form-label">

            Phương thức thanh toán

        </label>

        <select asp-for="PaymentMethod"
                class="form-select">

            <option value="@PaymentMethod.Cash">
                Tiền mặt
            </option>

            <option value="@PaymentMethod.COD">
                COD
            </option>

            <option value="@PaymentMethod.BankTransfer">
                Chuyển khoản
            </option>

        </select>

    </div>


    <div class="mb-3">

        <label asp-for="TransactionCode"
               class="form-label">

            Mã giao dịch

        </label>

        <input asp-for="TransactionCode"
               class="form-control" />

        <span asp-validation-for="TransactionCode"
              class="text-danger">
        </span>

    </div>


    <div class="mb-3">

        <label asp-for="Status"
               class="form-label">

            Trạng thái giao dịch

        </label>

        <select asp-for="Status"
                class="form-select">

            <option value="@PaymentStatus.Successful">
                Thành công
            </option>

            <option value="@PaymentStatus.Pending">
                Đang chờ
            </option>

            <option value="@PaymentStatus.Failed">
                Thất bại
            </option>

        </select>

    </div>


    <button type="submit"
            class="btn btn-primary">

        Ghi nhận thanh toán

    </button>


    <a asp-area="Management"
       asp-controller="Order"
       asp-action="Details"
       asp-route-id="@Model.OrderId"
       class="btn btn-secondary">

        Quay lại

    </a>

</form>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}