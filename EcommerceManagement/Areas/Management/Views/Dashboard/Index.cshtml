@using System.Text.Json
@model DashboardViewModel

@{
    ViewData["Title"] = "Tổng quan";
}

<h2>Tổng quan</h2>

<div class="row mb-4">

    <div class="col">
        <strong>Tổng sản phẩm:</strong>
        @Model.TotalProducts
    </div>

    <div class="col">
        <strong>Khách hàng:</strong>
        @Model.TotalCustomers
    </div>

    <div class="col">
        <strong>Đơn hàng:</strong>
        @Model.TotalOrders
    </div>

    <div class="col">
        <strong>Đang chờ xử lý:</strong>
        @Model.PendingOrders
    </div>

    <div class="col">
        <strong>Doanh thu:</strong>
        @Model.TotalRevenue.ToString("N0") đ
    </div>

</div>


<h4>5 đơn hàng mới nhất</h4>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Mã đơn</th>
            <th>Khách hàng</th>
            <th>Ngày tạo</th>
            <th>Tổng tiền</th>
            <th>Trạng thái</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var order in Model.LatestOrders)
        {
            <tr>
                <td>
                    <a asp-controller="Order"
                       asp-action="Details"
                       asp-route-id="@order.Id">
                        @order.OrderCode
                    </a>
                </td>

                <td>@order.CustomerName</td>

                <td>
                    @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </td>

                <td>
                    @order.TotalAmount.ToString("N0") đ
                </td>

                <td>
                    @order.StatusText
                </td>
            </tr>
        }

    </tbody>

</table>


<h4>Sản phẩm sắp hết hàng</h4>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>SKU</th>
            <th>Tồn kho</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.LowStockProducts)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.SKU</td>
                <td>@item.StockQuantity</td>
            </tr>
        }

    </tbody>

</table>


<h4>Doanh thu theo tháng</h4>

<canvas id="revenueChart"
        style="max-height: 350px;">
</canvas>


<h4 class="mt-4">
    Sản phẩm bán chạy nhất
</h4>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>Số lượng bán</th>
            <th>Doanh số</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.TopProducts)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.QuantitySold</td>
                <td>@item.Revenue.ToString("N0") đ</td>
            </tr>
        }

    </tbody>

</table>


<h4>Khách hàng có doanh số cao nhất</h4>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Khách hàng</th>
            <th>Số đơn</th>
            <th>Doanh số</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.TopCustomers)
        {
            <tr>
                <td>@item.CustomerName</td>
                <td>@item.OrderCount</td>
                <td>@item.TotalSales.ToString("N0") đ</td>
            </tr>
        }

    </tbody>

</table>


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const labels = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyRevenue.Select(x => x.Label)));

        const revenues = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyRevenue.Select(x => x.Revenue)));

        const context = document
            .getElementById("revenueChart")
            .getContext("2d");

    new Chart(context, {
        type: "bar",
        data: {
            labels: labels,
            datasets: [{
                label: "Doanh thu",
                data: revenues
            }]
        }
    });

</script>
}