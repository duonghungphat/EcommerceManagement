@model CustomerOrderHistoryViewModel

@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<div class="page-heading mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <h3 class="mb-1">Lịch sử đơn hàng</h3>
            <p class="text-muted mb-0">@Model.Customer.FullName · @Model.Customer.Email</p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Ngày tạo</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Tổng tiền</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Orders.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Khách hàng chưa có đơn hàng.</td>
                    </tr>
                }

                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td class="fw-semibold">@order.OrderCode</td>
                        <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge bg-primary">@order.StatusText</span></td>
                        <td class="text-end fw-semibold">@order.TotalAmount.ToString("N0") đ</td>
                        <td class="text-end">
                            <a asp-area="Management"
                               asp-controller="Order"
                               asp-action="Details"
                               asp-route-id="@order.Id"
                               class="btn btn-primary btn-sm">Chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
