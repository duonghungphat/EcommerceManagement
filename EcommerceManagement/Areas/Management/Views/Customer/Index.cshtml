@model CustomerListViewModel

@{
    ViewData["Title"] = "Khách hàng";
}

<form method="get"
      asp-action="Index"
      class="mb-3">

    <input asp-for="SearchTerm"
           placeholder="Tìm tên, email hoặc số điện thoại..." />

    <button type="submit">
        Tìm kiếm
    </button>

    <a asp-action="Index">
        Xóa lọc
    </a>
</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Danh sách khách hàng</h2>

    <a asp-action="Create"
       class="btn btn-primary">
        Thêm khách hàng
    </a>
    
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Họ tên</th>
            <th>Email</th>
            <th>SĐT</th>
            <th>Địa chỉ</th>
            <th>Ngày tạo</th>
            <th>Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Customers)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@item.PhoneNumber</td>
                <td>@item.Address</td>
                <td>
                    @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Sửa
                    </a>

                    <a asp-action="History"
                       asp-route-id="@item.Id">
                        Lịch sử đơn hàng
                    </a> 

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <form asp-action="Delete"
                              asp-route-id="@item.Id"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Bạn có chắc muốn xóa khách hàng này?');">

                            <button type="submit"
                                    class="btn btn-danger btn-sm">
                                Xóa
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>