@model CustomerListViewModel

@{
    ViewData["Title"] = "Khách hàng";
}

<div class="page-heading mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <h3 class="mb-1">Danh sách khách hàng</h3>
            <p class="text-muted mb-0">Quản lý thông tin và lịch sử mua hàng của khách hàng.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">Thêm khách hàng</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end crud-filter">
            <div class="col-md-8 col-lg-6">
                <input asp-for="SearchTerm"
                       class="form-control"
                       placeholder="Tìm tên, email hoặc số điện thoại..." />
            </div>

            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            </div>

            <div class="col-auto">
                <a asp-action="Index" class="btn btn-secondary">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>SĐT</th>
                    <th>Địa chỉ</th>
                    <th>Ngày tạo</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Customers.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Không tìm thấy khách hàng.</td>
                    </tr>
                }

                @foreach (var item in Model.Customers)
                {
                    <tr>
                        <td class="fw-semibold">@item.FullName</td>
                        <td>@item.Email</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.Address</td>
                        <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>

                        <td>
                            <div class="crud-actions">
                                <a asp-action="History" asp-route-id="@item.Id" class="btn btn-info btn-sm">Lịch sử</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>

                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <form asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa khách hàng này?');">
                                        <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
